# ── Database ───────────────────────────────────────────────────
# MySQL connection string. Required.
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://pricehunter:pricehunter_pass@localhost:3306/pricehunter

# ── Backend Security ───────────────────────────────────────────
# Application ID from Kimi Open Platform (open.kimi.com)
APP_ID=your_kimi_app_id

# Secret key for JWT signing. Must be at least 32 characters.
# Generate: openssl rand -base64 32
APP_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# ── Frontend (exposed to browser via Vite) ──────────────────────
# Kimi OAuth server URL
VITE_KIMI_AUTH_URL=https://auth.kimi.com

# OAuth application ID (same as APP_ID)
VITE_APP_ID=your_kimi_app_id

# ── Backend Kimi Integration ───────────────────────────────────
# Kimi Auth server URL (backend side)
KIMI_AUTH_URL=https://auth.kimi.com

# Kimi Open Platform URL
KIMI_OPEN_URL=https://open.kimi.com

# ── LLM Agent (optional but recommended) ────────────────────────
# Kimi API key for LLM-powered search agent.
# If not set, app falls back to DuckDuckGo + Bing scraping.
KIMI_API_KEY=

# Kimi API endpoint (optional)
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions

# Model name (optional)
KIMI_MODEL=kimi-k2-0905-preview

# ── Admin Role ──────────────────────────────────────────────────
# Union ID of the app creator. This user gets role "admin" on first login.
# Find your union ID in Kimi account settings.
OWNER_UNION_ID=your_union_id_here

# ── Node Environment ───────────────────────────────────────────
NODE_ENV=development
